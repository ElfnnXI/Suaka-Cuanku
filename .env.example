# Database URL - Replace with your PostgreSQL connection string
# Format: postgresql://user:password@localhost:5432/suaka_cuanku?schema=public
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/suaka_cuanku?schema=public"

# JWT Secret - Generate a random 64-char base64 string
JWT_SECRET="your-jwt-secret-here"

# Allowed origin list
ALLOWED_ORIGINS="http://localhost:3000"

# Cookie and proxy security
SESSION_COOKIE_SECURE="false"
TRUST_PROXY_HEADERS="false"

# Password breach checking
PASSWORD_BREACH_CHECK_MODE="best-effort"
HIBP_RANGE_API_URL="https://api.pwnedpasswords.com/range"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="Suaka Cuanku"

# Seed admin bootstrap (used by prisma/seed.ts)
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="your-seed-password-here"
