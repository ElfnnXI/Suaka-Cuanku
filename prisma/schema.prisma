// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  AUDITOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
}

model User {
  id          String      @id @default(uuid())
  name        String
  email       String      @unique @db.VarChar(100)
  password    String
  sessionVersion Int      @default(0)
  role        Role        @default(USER)
  status      UserStatus  @default(ACTIVE)
  riskLevel   RiskLevel   @default(LOW)
  riskReason  String?
  loanLimit   Int         @default(30000000)
  updatedAt   DateTime    @updatedAt @default(now())
  createdAt   DateTime    @default(now())
  loans       Loan[]
  auditLogs   AuditLog[]
  securityQuestions SecurityQuestion[]
  backupSetting AdminBackupSetting?

  @@index([role, status, createdAt])
}

model AdminBackupSetting {
  id                  String   @id @default(uuid())
  adminId             String   @unique
  destinationDirectory String
  fileName            String   @default("suaka-cuanku-backup.json")
  autoBackupEnabled   Boolean  @default(false)
  intervalDays        Int?
  lastBackupAt        DateTime?
  nextBackupAt        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  admin               User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_backup_settings")
}

model Loan {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  interest  Float
  duration  Int
  status    LoanStatus @default(PENDING)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model Payment {
  id       String   @id @default(uuid())
  loanId   String
  amount   Float
  paidAt   DateTime @default(now())
  status   PaymentStatus @default(PENDING)

  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, status, paidAt])
  @@index([status, paidAt])
}

model Comment {
  id        String   @id @default(uuid())
  name      String
  email     String   @db.VarChar(100)
  message   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  auditorId   String
  action      String   // VIEW_LOANS, VIEW_USERS, VIEW_PAYMENTS, GENERATE_REPORT, etc.
  description String
  details     String?  @db.Text
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  auditor     User     @relation(fields: [auditorId], references: [id], onDelete: Cascade)

  @@index([auditorId, createdAt])
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime @map("reset_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rate_limit_entries")
}

model SecurityQuestion {
  id        String   @id @default(uuid())
  userId    String
  question  String   // NAMA_MASA_KECIL, KOTA_IMPIAN, ANGKA_HARAPAN, KATA_ABSURD, MEREK_FAVORIT
  answer    String   // bcrypt hash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, question])
  @@index([userId])
  @@map("security_questions")
}
